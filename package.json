          "workspace",
          "session"
        ],
        "verbs": [
          "open"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggdrasilhq/yfiles.git"
  },
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "provenance": true
