{
  "name": "@ygghq/yfiles",
  "version": "0.1.0",
  "description": "yfiles - the yggdrasilhq build, delivered by ynpm",
  "bin": {
    "yfiles": "bin/yfiles"
  },
  "files": [
    "bin/",
    "finalize.mjs"
  ],
  "optionalDependencies": {
    "@ygghq/yfiles-linux-x64": "0.1.0",
    "@ygghq/yfiles-linux-arm64": "0.1.0",
    "@ygghq/yfiles-darwin-x64": "0.1.0",
    "@ygghq/yfiles-darwin-arm64": "0.1.0",
    "@ygghq/yfiles-win32-x64": "0.1.0",
    "@ygghq/yfiles-win32-arm64": "0.1.0"
  },
  "scripts": {
    "postinstall": "node ./finalize.mjs"
  },
  "yggterm": {
    "app": {
      "name": "yfiles",
      "label": "Yfiles",
      "icon": "",
      "binary": "yfiles",
      "verbs": [
        {
